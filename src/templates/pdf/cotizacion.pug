doctype html
html
  head
    meta(charset="UTF-8")
    title Cotización #{cotizacion.codigo}
    style
      include cotizacion.css

  body
    // ============================================
    // PÁGINA 1: RESUMEN Y PRECIO
    // ============================================
    
    // Header
    .header
      .logo-section
        .logo-placeholder LOGO
        .company-info
          h1 TRIP CONECTA
          .tagline Viajes y Turismo B2B
      .quote-info
        .quote-number #{cotizacion.codigo}
        .quote-date Fecha: #{cotizacion.fecha_creacion}
        .quote-date Válida hasta: #{cotizacion.fecha_expiracion}

    // Client Info
    .client-section
      .client-box
        h3 👤 Cliente
        p
          span.label Nombre:
          |  #{cliente.nombre} #{cliente.apellido}
        if cliente.documento
          p
            span.label Documento:
            |  #{cliente.documento}
        if cliente.email
          p
            span.label Email:
            |  #{cliente.email}
        if cliente.telefono
          p
            span.label Teléfono:
            |  #{cliente.telefono}
      
      .client-box
        h3 ✈️ Configuración del Viaje
        p
          span.label Pasajeros:
          |  #{cotizacion.num_pasajeros}
        if cotizacion.tipo_habitacion
          p
            span.label Tipo Habitación:
            |  #{cotizacion.tipo_habitacion}
        if cotizacion.fecha_salida
          p
            span.label Fecha Salida:
            |  #{cotizacion.fecha_salida}

    // Package Summary
    .package-section
      h2 📦 Paquete Turístico
      .package-card
        .package-image
          if paquete.imagen_principal
            img(src=paquete.imagen_principal alt=paquete.titulo)
          else
            span Imagen no disponible
        .package-details
          h3 #{paquete.titulo}
          .package-meta
            .meta-item
              strong Destino:
              |  #{paquete.destino}
            .meta-item
              strong Duración:
              |  #{paquete.duracion_dias} días
          .package-description= paquete.descripcion

    // Passengers
    if pasajeros && pasajeros.length > 0
      .passengers-section
        h2 👥 Pasajeros (#{pasajeros.length})
        table.passengers-table
          thead
            tr
              th #
              th Nombre
              th Documento
              th Fecha Nac.
              th Nacionalidad
          tbody
            each pasajero, index in pasajeros
              tr
                td= index + 1
                td #{pasajero.nombre} #{pasajero.apellido}
                td #{pasajero.documento || '-'}
                td #{pasajero.fecha_nacimiento || '-'}
                td #{pasajero.nacionalidad || '-'}

    // Pricing
    .pricing-section
      h2 💰 Detalle de Precios
      table.pricing-table
        thead
          tr
            th Concepto
            th.text-right Precio Unit.
            th.text-right Cantidad
            th.text-right Subtotal
        tbody
          tr
            td #{paquete.titulo} - #{cotizacion.tipo_habitacion || 'Estándar'}
            td.text-right #{precios.moneda} #{precios.precio_unitario}
            td.text-right #{cotizacion.num_pasajeros}
            td.text-right #{precios.moneda} #{precios.subtotal}
          if precios.impuestos > 0
            tr
              td(colspan="3") Impuestos y tasas
              td.text-right #{precios.moneda} #{precios.impuestos}
          if precios.extras > 0
            tr
              td(colspan="3") Servicios adicionales
              td.text-right #{precios.moneda} #{precios.extras}
        tfoot
          tr.total-row
            td(colspan="3") TOTAL A PAGAR
            td.text-right #{precios.moneda} #{precios.total}

    // Payment Info
    .payment-section
      h3 💳 Información de Pago
      .payment-grid
        .payment-item
          span.label Anticipo requerido (30%):
          span.value #{precios.moneda} #{precios.anticipo}
        .payment-item
          span.label Saldo a pagar:
          span.value #{precios.moneda} #{precios.saldo}
        .payment-item
          span.label Métodos de pago:
          span.value Transferencia / Depósito / Tarjeta
        .payment-item
          span.label Moneda:
          span.value #{precios.moneda}

    // Validity
    .validity-banner
      p ⏰ Esta cotización tiene una validez de <strong>#{cotizacion.dias_validez} días</strong> desde la fecha de emisión. Los precios están sujetos a disponibilidad y pueden variar sin previo aviso.

    // Seller Info
    .seller-section
      h3 📞 Vendedor Asignado
      .seller-card
        .seller-avatar #{vendedor.iniciales}
        .seller-info
          p.name #{vendedor.nombre} #{vendedor.apellido}
          p.contact #{vendedor.email} | #{vendedor.telefono || 'Sin teléfono'}

    // Footer Page 1
    .footer
      p Trip Conecta B2B - Plataforma de viajes para agencias
      p www.tripconecta.com | soporte@tripconecta.com
      p.disclaimer Los precios indicados son válidos al momento de la cotización y pueden estar sujetos a cambios por fluctuación cambiaria o disponibilidad de servicios.

    // ============================================
    // PÁGINA 2: ITINERARIO
    // ============================================
    .page-break
    
    .itinerary-section
      h2 🗓️ Itinerario Detallado
      
      if itinerario && itinerario.length > 0
        each dia in itinerario
          .day-card
            .day-header
              .day-number Día #{dia.dia}
              .day-title= dia.titulo
            .day-content
              p= dia.descripcion
              if dia.actividades && dia.actividades.length > 0
                each actividad in dia.actividades
                  p • #{actividad}
      else
        .day-card
          .day-content
            p El itinerario detallado será proporcionado por el operador turístico una vez confirmada la reserva.

    // Includes / Not Includes
    if incluye || no_incluye
      .includes-section
        .includes-grid
          if incluye && incluye.length > 0
            .include-box.incluye
              h3 ✅ El paquete incluye
              ul
                each item in incluye
                  li= item
          
          if no_incluye && no_incluye.length > 0
            .include-box.no-incluye
              h3 ❌ El paquete NO incluye
              ul
                each item in no_incluye
                  li= item

    // Policies
    if paquete.politicas_cancelacion
      .policies-section
        h3 📋 Políticas de Cancelación
        p= paquete.politicas_cancelacion

    // Footer Page 2
    .footer
      p Esta cotización fue generada automáticamente por el sistema Trip Conecta B2B
      p Para confirmar esta reserva, contacte a su vendedor asignado
