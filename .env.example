# ==========================================
# Trip Conecta API - Variables de Entorno
# ==========================================

# Puerto del servidor
PORT=3001

# Entorno (development | production)
NODE_ENV=development

# JWT Secret (generar uno seguro para producción)
# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=cambiar-por-un-secreto-seguro-de-al-menos-32-caracteres

# Base de Datos - Desarrollo (SQLite)
DB_PATH=./database/trip_conecta.db

# ==========================================
# SUPABASE CONFIGURACIÓN (PRODUCCIÓN)
# ==========================================
# IMPORTANTE: Usar SUPABASE_SERVICE_ROLE_KEY, NO la anon key
# La service role key evita las restricciones RLS para operaciones de backend
# Obtener desde: Supabase Dashboard → Project Settings → API → service_role key
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ8...

# Base de Datos - Producción Directa (Opcional)
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-ID].supabase.co:5432/postgres

# Almacenamiento de archivos
STORAGE_PATH=./storage/uploads

# URL pública de la API para generar URLs absolutas de archivos (sin /api)
# Ejemplo: https://api.tripconecta.com
API_BASE_URL=

# Nivel de logging (trace | debug | info | warn | error | fatal)
LOG_LEVEL=info

# Orígenes permitidos para CORS (separados por comas)
# En desarrollo:
CORS_ORIGIN=http://localhost:3000
# En producción:
# CORS_ORIGIN=https://panel.tripconecta.com

# Configuración de cookies (producción)
# COOKIE_SECURE=true
# COOKIE_SAME_SITE=none

# ==========================================
# STRIPE CONFIGURACIÓN
# ==========================================
# Obtener desde: Stripe Dashboard → Developers → API keys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Price IDs de Stripe para cada plan (obtener desde Stripe Dashboard → Product catalog)
STRIPE_PRICE_ID_FREE=price_...
STRIPE_PRICE_ID_FREELANCE=price_...
STRIPE_PRICE_ID_PRO_AGENCIA=price_...
STRIPE_PRICE_ID_PRO_ILIMITADO=price_...
STRIPE_PRICE_ID_EXTRA_USER=price_...

# URL pública del panel para redirecciones de Stripe Checkout
FRONTEND_URL=http://localhost:3000
